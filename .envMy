# Add project environment variables here.
# ==============================================================================
# ENVIRONMENT & GENERAL CONFIGURATION
# ==============================================================================
ENV=local
NODE_ENV=development
BASE_URL=http://localhost/opencart/upload
HEADLESS=true
BROWSER=chromium
DEFAULT_TIMEOUT=30000

# ==============================================================================
# WEB APPLICATION TEST ACCOUNTS
# ==============================================================================
# Admin Credentials
ADMIN_USER=admin
ADMIN_PASS=admin123
ADMIN_URL=http://localhost/opencart/upload/admin

# Standard User Credentials
USER_EMAIL=testuser@example.com
USER_PASSWORD=Password123!

# ==============================================================================
# REST API CONFIGURATION
# ==============================================================================
# OpenCart REST API Endpoint & Tokens
API_BASE_URL=http://localhost/opencart/upload/index.php?route=api
API_USERNAME=Default
API_KEY=your_opencart_api_key_here
API_BEARER_TOKEN=

# ==============================================================================
# DATABASE CONFIGURATION (mysql2 integration)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=opencart_db
DB_USER=root
DB_PASSWORD=root
DB_PREFIX=oc_
DB_CONNECTION_LIMIT=10

# ==============================================================================
# MOBILE TESTING CONFIGURATION (Appium / Emulators / Viewports)
# ==============================================================================
# Mobile Web Viewport Emulation (Playwright Device Emulation)
MOBILE_DEVICE_NAME=Pixel 5
MOBILE_PLATFORM=android

# Mobile Native / Appium Options (If executing native mobile tests)
APPIUM_SERVER_URL=http://127.0.0.1:4723/wd/hub
MOBILE_APP_PATH=./apps/opencart_mobile.apk
DEVICE_NAME=emulator-5554
PLATFORM_VERSION=13.0

# ==============================================================================
# TEST DATA & UTILITIES CONFIGURATION
# ==============================================================================
TESTDATA_PATH=./testdata/testdata.xlsx
GENERATE_FAKER_SEED=12345

# ==============================================================================
# REPORTING & LOGGING CONFIGURATION
# ==============================================================================
ALLURE_RESULTS_DIR=./allure-results
REPORTS_DIR=./reports
SCREENSHOT_ON_FAILURE=true
TRACE_ON_FAILURE=true
VIDEO_ON_FAILURE=retain-on-failure